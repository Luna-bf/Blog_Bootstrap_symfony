{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Blog Bootstrap
{% endblock %}

{% block body %}
	<body class="settings-form">
		<div class="d-flex flex-column form-div">
			{% for flash_error in app.flashes('reset_password_error') %}
				<div class="alert alert-danger" role="alert">{{ flash_error }}</div>
			{% endfor %}
			<h1 class="my-5 text-center text-dark">Reset your password</h1>

			{{ form_start(requestForm, { 'attr': {'class': 'w-50 d-flex flex-column justify-content-center rounded-3'}}) }}
                <div class="d-flex flex-column form-parent-row my-4">
                    {{ form_label(requestForm.email, null, {'label_attr': {'class': 'form-label'}}) }}

                    <div class="d-flex align-items-center text-danger list-unstyled error-message">
                        {{ form_errors(requestForm.email) }}
                    </div>

                    {{ form_widget(requestForm.email, {'attr': {'class': 'form-control'}}) }}
                    
                    <small class="mt-1 mb-5 text-info">
                        <i class="fa-solid fa-circle-info"></i>
                        Saisissez votre adresse mail et nous vous enverrons un lien pour réinitialiser votre mot de passe.
                    </small>
                </div>

                <button class="btn mx-auto text-light bg-dark">Envoyer l'email</button>
			{{ form_end(requestForm) }}
		</div>
	</body>
{% endblock %}

{% block footer %}
	<footer class="bg-dark text-light d-flex align-items-center justify-content-center position-absolute bottom-0">
		<p class="m-0 text-center">Travail réalisé par
			<a href="https://github.com/Luna-bf" target="_blank" class="text-decoration-none">Luna</a>.</p>
	</footer>
{% endblock %}
