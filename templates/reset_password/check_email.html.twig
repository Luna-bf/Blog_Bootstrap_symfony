{% extends 'base.html.twig' %}

{% block title %}Email de réinitialisation du mot de passe envoyé
{% endblock %}

{% block body %}
	<div class="d-flex flex-column align-items-center justify-content-center mt-5">
		<p class="mt-5">
			Si un compte correspondant à votre adresse mail existe, un email contenant un lien vous permettant de réinitialiser votre mot de passe vient de vous être envoyé.
			        Ce lien expire dans
			{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
		</p>
		<p>Si vous ne recevez pas d'e-mail, veuillez vérifier votre dossier de courriers indésirables ou
			<a href="{{ path('app_forgot_password_request') }}">réessayez</a>.</p>
	</div>
{% endblock %}

{% block footer %}
	<footer class="bg-dark text-light d-flex align-items-center justify-content-center position-absolute bottom-0">
		<p class="m-0 text-center">Travail réalisé par
			<a href="https://github.com/Luna-bf" target="_blank" class="text-decoration-none">Luna</a>.</p>
	</footer>
{% endblock %}
